[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://main.gd" id="1_main"]
[ext_resource type="Script" path="res://board.gd" id="2_board"]
[ext_resource type="Script" path="res://anim_layer.gd" id="3_anim"]

[node name="Main" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_main")

[node name="Root" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 16
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 16
theme_override_constants/margin_bottom = 12

[node name="Layout" type="VBoxContainer" parent="Root"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TopBar" type="HBoxContainer" parent="Root/Layout"]
layout_mode = 2
theme_override_constants/separation = 18

[node name="ScoreLabel" type="Label" parent="Root/Layout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "分数 0"
horizontal_alignment = 1

[node name="BestLabel" type="Label" parent="Root/Layout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "最高 0"
horizontal_alignment = 1

[node name="EnergyLabel" type="Label" parent="Root/Layout/TopBar"]
layout_mode = 2
size_flags_horizontal = 3
text = "♥♥♥♥♥  5/5"
horizontal_alignment = 1

[node name="BoardWrapper" type="AspectRatioContainer" parent="Root/Layout"]
layout_mode = 2
size_flags_vertical = 3
ratio = 1.0

[node name="BoardStack" type="Control" parent="Root/Layout/BoardWrapper"]
layout_mode = 2

[node name="Board" type="GridContainer" parent="Root/Layout/BoardWrapper/BoardStack"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/h_separation = 6
theme_override_constants/v_separation = 6
columns = 5
script = ExtResource("2_board")

[node name="AnimLayer" type="Control" parent="Root/Layout/BoardWrapper/BoardStack"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
script = ExtResource("3_anim")

[node name="BottomBar" type="VBoxContainer" parent="Root/Layout"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="StatusLabel" type="Label" parent="Root/Layout/BottomBar"]
layout_mode = 2
text = "点击数字方块使其 +1（消耗 1 点能量）；横竖三连及以上自动合成"
horizontal_alignment = 1
autowrap_mode = 3

[node name="RestartButton" type="Button" parent="Root/Layout/BottomBar"]
layout_mode = 2
text = "重新开始"

[node name="Overlay" type="Control" parent="."]
visible = false
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Dim" type="ColorRect" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0, 0, 0, 0.65)

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2

[node name="Panel" type="PanelContainer" parent="Overlay/Center"]
layout_mode = 2

[node name="Margin" type="MarginContainer" parent="Overlay/Center/Panel"]
layout_mode = 2
theme_override_constants/margin_left = 28
theme_override_constants/margin_top = 20
theme_override_constants/margin_right = 28
theme_override_constants/margin_bottom = 20

[node name="Box" type="VBoxContainer" parent="Overlay/Center/Panel/Margin"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="OverlayTitle" type="Label" parent="Overlay/Center/Panel/Margin/Box"]
layout_mode = 2
text = "标题"
horizontal_alignment = 1

[node name="OverlayDetail" type="Label" parent="Overlay/Center/Panel/Margin/Box"]
layout_mode = 2
text = "详情"
horizontal_alignment = 1
autowrap_mode = 3

[node name="ReviveButton" type="Button" parent="Overlay/Center/Panel/Margin/Box"]
layout_mode = 2
text = "复活"

[node name="GiveUpButton" type="Button" parent="Overlay/Center/Panel/Margin/Box"]
layout_mode = 2
text = "结束本局"

[node name="OverlayRestartButton" type="Button" parent="Overlay/Center/Panel/Margin/Box"]
layout_mode = 2
text = "重新开始"

[connection signal="pressed" from="Root/Layout/BottomBar/RestartButton" to="." method="_on_restart_pressed"]
[connection signal="pressed" from="Overlay/Center/Panel/Margin/Box/ReviveButton" to="." method="_on_revive_pressed"]
[connection signal="pressed" from="Overlay/Center/Panel/Margin/Box/GiveUpButton" to="." method="_on_give_up_pressed"]
[connection signal="pressed" from="Overlay/Center/Panel/Margin/Box/OverlayRestartButton" to="." method="_on_restart_pressed"]
